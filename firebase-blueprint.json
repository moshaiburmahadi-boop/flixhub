{
  "entities": {
    "Movie": {
      "title": "Movie",
      "description": "A curated movie in the FlixDairy vault",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Movie title",
          "maxLength": 200
        },
        "posterUrl": {
          "type": "string",
          "description": "URL to the movie poster image",
          "maxLength": 1000
        },
        "backdropUrl": {
          "type": "string",
          "description": "URL to backdrop or landscape banner image",
          "maxLength": 1000
        },
        "personalRating": {
          "type": "number",
          "description": "Personal rating out of 10"
        },
        "imdbRating": {
          "type": "number",
          "description": "IMDb rating out of 10"
        },
        "duration": {
          "type": "string",
          "description": "Duration of the movie (e.g. 2h 28m)",
          "maxLength": 50
        },
        "releaseYear": {
          "type": "number",
          "description": "Release year of the movie"
        },
        "category": {
          "type": "string",
          "description": "Main genre / category name",
          "maxLength": 100
        },
        "subCategory": {
          "type": "string",
          "description": "Sub-category or specific tag",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Synopsis of the movie",
          "maxLength": 3000
        },
        "personalReview": {
          "type": "string",
          "description": "Personal opinion, thoughts and detailed review notes",
          "maxLength": 5000
        },
        "watchUrl": {
          "type": "string",
          "description": "External web link to stream or view the movie",
          "maxLength": 1000
        },
        "featured": {
          "type": "boolean",
          "description": "Whether to highlight as featured hero banner"
        },
        "dateWatched": {
          "type": "string",
          "description": "Date watched in ISO format YYYY-MM-DD",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 50
        }
      },
      "required": [
        "title",
        "posterUrl",
        "personalRating",
        "imdbRating",
        "duration",
        "category",
        "watchUrl"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Movie category and associated subcategories",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Category name",
          "maxLength": 100
        },
        "subCategories": {
          "type": "array",
          "description": "List of subcategories"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 50
        }
      },
      "required": [
        "name"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin identity and access record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "description": "Admin role",
          "enum": ["admin", "superadmin"]
        },
        "createdAt": {
          "type": "string",
          "description": "Admin grant timestamp",
          "maxLength": 50
        }
      },
      "required": [
        "email",
        "role"
      ]
    }
  },
  "firestore": {
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "Collection of movies in the FlixDairy vault. Public read, admin write."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of main categories and sub-categories. Public read, admin write."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Designated administrators allowed to manage the FlixDairy vault."
    }
  }
}
