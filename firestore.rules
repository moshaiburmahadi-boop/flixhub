rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public read and validated writes for FlixDairy vault
    match /movies/{movieId} {
      allow read: if true;
      allow create, update: if isValidId(movieId) && 
                              request.resource.data.title is string && 
                              request.resource.data.title.size() > 0;
      allow delete: if isValidId(movieId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && 
                              request.resource.data.name is string && 
                              request.resource.data.name.size() > 0;
      allow delete: if isValidId(categoryId);
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
